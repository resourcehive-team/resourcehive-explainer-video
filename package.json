{
  "name": "resourcehive-explainer-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "export-voice-text": "node scripts/export-voice-text.mjs",
    "check-assets": "node scripts/check-assets.mjs",
    "sync-timing": "node scripts/sync-timing.mjs",
    "build-captions": "node scripts/build-captions.mjs",
    "render:preview": "remotion render src/index.ts ResourceHiveExplainer output/preview.mp4 --codec h264 --crf 20",
    "render:master": "node scripts/render-draft.mjs",
    "compress": "node scripts/compress.mjs",
    "verify": "node scripts/verify.mjs",
    "submission": "pnpm run render:draft",
    "typecheck": "tsc --noEmit",
    "render:draft": "node scripts/render-draft.mjs",
    "align-captions": "python scripts/align-captions.py"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@remotion/cli": "4.0.532",
    "lucide-react": "^1.49.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.532",
    "simple-icons": "^16.33.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
